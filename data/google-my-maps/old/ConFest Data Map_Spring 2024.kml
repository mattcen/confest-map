<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>ConFest Data Map_Spring 2024</name>
    <description><![CDATA[This is the data collection map from the end of Spring 2024 event :-D<br>THIS MAP IS NOW SUPERSEDED BY THE PRINTED OPS MAP. REFER TO THAT MAP NOW.<br><br>ANY CREW COULD PREVIOUSLY EDIT THIS PLANNING MAP.<br>How-to edit the Spring Planning Map: https://docs.google.com/document/d/1Y6X-bCFlp_yMU_GGjVB4nKzvBfhZoYsx2O0F1KEx7Nw/edit?usp=sharing<br><br>ConFest site co-design for next event in Spring.<br><br>Mapping Facilitator: Dane Murray. <br>Email: confest.maps@gmail.com]]></description>
