<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Villages Map 2025 Spring ConFest</name>
    <description><![CDATA[The ConFest Spring 2025 Villages Map can be edited by anyone via the Villages Facilitator. How-to edit: (click here) https://docs.google.com/document/d/1A9nWr1ProEjxZgEtkT7qQnGuyeWfzacdHLwWilABtfQ/edit?usp=sharing<br><br>* Only edit the Villages layer on this map.<br><br>* The Villages layer will be imported into the ConFest Planning Map which all event Facilitators are using to compile all spatial data to co-design the event site.<br><br>* The printable versions of the map will be based off this data.<br><br>Contacts:<br>Villages Facilitator: Aaron Shipperlee<br>Mapping Facilitator: Dane Murray<br><br>Email: confest.maps@gmail.com]]></description>
